# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
PORT=3000
# MongoDB ในเครื่อง หรือ connection string จาก MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/catshop
# สุ่มสตริงยาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# (ไม่บังคับ) เปิดปุ่มเข้าสู่ระบบด้วย Google: ใส่ Client ID จาก Google Cloud Console
# ลงท้ายด้วย .apps.googleusercontent.com (ปล่อยว่างไว้ ปุ่ม Google จะไม่แสดง)
GOOGLE_CLIENT_ID=

# (ไม่บังคับ) ส่งอีเมลลิงก์รีเซ็ตรหัสผ่านผ่าน SMTP เช่น Gmail (ใช้ App Password ไม่ใช่รหัสผ่านปกติ)
# ถ้าไม่ตั้งค่า ลิงก์จะถูกพิมพ์ในหน้าจอ terminal ที่รันเซิร์ฟเวอร์ (ใช้ทดสอบบนเครื่องตัวเองได้)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# ที่อยู่เว็บที่ใส่ในลิงก์อีเมล (เครื่องตัวเองตอนพัฒนา = http://localhost:5173, ใช้งานจริงใส่โดเมนของร้าน)
APP_URL=http://localhost:5173
# ตอนออนไลน์เท่านั้น: จำนวนพร็อกซีหน้าเซิร์ฟเวอร์ (หน้าเว็บบน Vercel + API บน Render = 2)
TRUST_PROXY=2

# อีเมลที่รับข้อความจากหน้า "ติดต่อเรา" (ถ้าไม่ตั้งจะใช้ MAIL_FROM; ยังไม่ตั้ง SMTP ข้อความจะแสดงใน terminal)
CONTACT_EMAIL=

# (ไม่บังคับ) ลูกค้าแจ้งคืน/เปลี่ยนสินค้าได้กี่วันหลังกดยืนยันรับสินค้า (ค่าเริ่มต้น 7)
RETURN_WINDOW_DAYS=7
# ออเดอร์ที่ยังไม่แนบสลิปต้องชำระภายในกี่นาที ครบแล้วระบบยกเลิกอัตโนมัติและคืนสต็อก
PAY_WINDOW_MINUTES=5

# (ไม่บังคับ) จัดส่งแล้วกี่วันถึงยืนยันรับสินค้าให้อัตโนมัติ ถ้าลูกค้าไม่กดเอง (ค่าเริ่มต้น 7)
AUTO_RECEIVE_DAYS=7
